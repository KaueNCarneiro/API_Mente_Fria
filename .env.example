# Mente Fria API — modelo de variáveis de ambiente (P1-10).
#
# Copie para `.env` (ignorado pelo git) SOMENTE em desenvolvimento local.
# O arquivo `.env` só é lido quando MENTE_FRIA_ENV é "local" (ou não definido).
# Em implantação (MENTE_FRIA_ENV=production) os valores devem vir do ambiente de
# execução / secret manager — nunca de arquivo versionado. Não versione segredos reais.

# Ambiente: local | test | production (qualquer ambiente implantado usa "production").
MENTE_FRIA_ENV=local

# Banco. Em "local" o padrão é sqlite:///./mente_fria.db; em "test" é sqlite:///:memory:.
# Em "production" é OBRIGATÓRIO. O ambiente "test" recusa o arquivo de desenvolvimento.
# MENTE_FRIA_DATABASE_URL=sqlite:///./mente_fria.db

# Segredo de assinatura do JWT (HS256). Gere um valor aleatório, por exemplo com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Em "production": mínimo de 32 caracteres e proibido manter o placeholder abaixo.
MENTE_FRIA_JWT_SECRET_KEY=CHANGE_ME_local_only_replace_with_random_value

# Expiração do token em segundos (obrigatória; o contrato não fixa a duração).
# O valor abaixo é apenas um EXEMPLO de desenvolvimento; a política oficial está
# pendente de aprovação (PLAN.md, decisões técnicas, item 3).
MENTE_FRIA_JWT_ACCESS_TOKEN_EXPIRE_SECONDS=3600

# Origens permitidas por CORS, como lista JSON. Vazio/ausente = CORS desabilitado.
# Não presuma origens de produção; "*" é recusado em "production".
# MENTE_FRIA_CORS_ALLOWED_ORIGINS=["http://localhost:3000"]

# Nível de log: CRITICAL | ERROR | WARNING | INFO | DEBUG
MENTE_FRIA_LOG_LEVEL=INFO
